# Copy to .env. The worker's container reaches Redis by its compose service name.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BROKER_TRANSPORT_OPTIONS={"visibility_timeout": 3600}

# The same bucket as the backend. Best: the wsi-ml-worker key from `terraform output -raw ml_worker_env`, which can
# only read hotspot images and write segmentation results. The BUCKET_* values of backend/.env.local also work.
BUCKET_ENDPOINT=https://s3.eu-north-1.amazonaws.com
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
BUCKET_REGION=eu-north-1

LOG_LEVEL=INFO
