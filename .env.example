# Copy to .env.local: the worker for the backend's local stack (backend/docker-compose.yml), started with
# `docker compose --profile local up -d --build`. These are its Redis and S3Mock as seen from this container; any S3
# credentials work against S3Mock.
#
# The worker for the deployed app reads .env.aws instead (`--profile aws`): the output of
# `terraform output -raw ml_worker_env` in backend/infra (SQS, the real bucket and the wsi-ml-worker key), plus any of
# the optional settings below.
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_BROKER_TRANSPORT_OPTIONS={"visibility_timeout": 3600}
BUCKET_ENDPOINT=http://host.docker.internal:9090
BUCKET_ACCESS_KEY=local
BUCKET_SECRET_KEY=local-secret
BUCKET_NAME=wsi-slides
BUCKET_REGION=us-east-1

LOG_LEVEL=INFO
